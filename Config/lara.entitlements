<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>platform-application</key>
	<true/>
	<key>proc_info-allow</key>
	<true/>
	<key>com.apple.private.persona-mgmt</key>
	<true/>
	<key>com.apple.private.tcc.allow</key>
	<array>
		<string>kTCCServiceSystemPolicyAllFiles</string>
	</array>
	<key>com.apple.private.security.storage-exempt.heritable</key>
	<true/>
	<key>com.apple.private.security.storage.AppBundles</key>
	<true/>
	<key>com.apple.private.security.no-sandbox</key>
	<true/>
	<key>com.apple.springboard.CFUserNotification</key>
	<true/>
	<key>com.apple.springboard.launchapplications</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- AirTroller: the app sandbox profile honours this key (it is referenced
	     by the compiled application profile in AppleSandbox.kext) and, unlike
	     no-sandbox, it is NOT on AMFI's privileged-entitlement list, so a
	     dev-signed binary keeps it. It is what grants the com.apple.sharingd
	     mach lookup that SFAirDropBrowser/SFOperation need.
	     NOTE: isideload (and SideStore) replace the app's entitlements with the
	     provisioning profile's, so this key only takes effect for installs that
	     sign with this manifest (TrollStore / ldid). For isideload installs the
	     installed binary carries none of these - the runtime report in
	     AirTrollerBridge logs exactly what survived. -->
	<key>com.apple.security.exception.mach-lookup.global-name</key>
	<array>
		<string>com.apple.sharingd</string>
		<string>com.apple.sharingd.nsxpc</string>
		<string>com.apple.sharingd.paireddevice</string>
	</array>
	<key>com.apple.private.mobileinstall.allowedSPI</key>
	<array>
		<string>InstallForLaunchServices</string>
		<string>Install</string>
		<string>UninstallForLaunchServices</string>
		<string>Uninstall</string>
		<string>UpdatePlaceholderMetadata</string>
	</array>
	<key>com.apple.security.exception.iokit-user-client-class</key>
	<array>
		<string>AGXDevice</string>
		<string>AGXDeviceUserClient</string>
		<string>AGXSharedUserClient</string>
		<string>AGXGLContext</string>
		<string>AGXCommandQueue</string>
		<string>IOSurfaceRoot</string>
		<string>IOSurfaceRootUserClient</string>
		<string>AppleJPEGDriverUserClient</string>
		<string>H11ANEInDirectPathClient</string>
	</array>
	<key>com.apple.developer.kernel.extended-virtual-addressing</key>
	<true/>
	<key>com.apple.developer.kernel.increased-memory-limit</key>
	<true/>
	<!-- CarPlay: template scene gate. RE of iOS 26 CarPlay.framework shows
	     -[CPTemplateApplicationScene _shouldCreateCarWindow] reduces to
	     _CPCurrentProcessHasMapsEntitlement, which checks this key via
	     bundleProxyForCurrentProcess + entitlementValuesForKeys + boolForKey.
	     TrollStore/CoreTrust self-grants it, so the head-unit scene passes
	     the gate on-device. No Apple approval needed for TrollStore installs,
	     but a real App Store build still requires an approved CarPlay
	     entitlement profile. This does NOT enable pixel screen mirroring:
	     CarPlay only allows template UI (lists/grids/alerts). -->
	<key>com.apple.developer.carplay-maps</key>
	<true/>
</dict>
</plist>
